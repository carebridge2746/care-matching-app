# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 git에 커밋하지 않는다.
#
# EXPO_PUBLIC_ 접두사가 붙은 값은 클라이언트 번들에 그대로 포함된다.
# 따라서 LLM API Key, Supabase service_role key 등 비밀값은 절대 여기에 두지 않는다.
# 비밀값은 Supabase Edge Function 의 secret 으로만 설정한다.
#
# 값을 바꾼 뒤에는 개발 서버를 다시 시작해야 반영된다 (번들 시점에 값이 박힌다).

# 인증 방식: mock = 로컬 AsyncStorage 기반 Mock 인증, supabase = Supabase Auth
# supabase 로 바꾸려면 아래 URL 과 공개 키를 먼저 채우고,
# supabase/schema.sql 을 프로젝트에 적용해야 한다.
EXPO_PUBLIC_AUTH_MODE=mock

# LLM 호출 방식: mock = 로컬 테스트 결과 반환, live = Edge Function 경유 실제 호출
EXPO_PUBLIC_LLM_MODE=mock

# Supabase 프로젝트 URL — 대시보드 Project Settings → Data API
EXPO_PUBLIC_SUPABASE_URL=

# 공개 키 (sb_publishable_... ). 공개해도 되는 키이며 접근 제어는 RLS 로 수행한다.
# 대시보드 Project Settings → API Keys
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 예전에 만든 프로젝트라 publishable key 가 없으면 anon key 를 대신 쓴다.
# 둘 다 있으면 publishable key 가 우선한다.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
